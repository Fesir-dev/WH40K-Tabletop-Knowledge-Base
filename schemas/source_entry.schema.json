{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/source_entry.schema.json",
  "title": "WH40K Tabletop Source Entry",
  "type": "object",
  "required": [
    "id",
    "authority",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "authority": {
      "enum": [
        "official_primary",
        "official_secondary",
        "secondary_reference",
        "structured_implementation",
        "runtime_projection",
        "tooling_reference",
        "empirical_dataset",
        "expert_analysis",
        "event_overlay",
        "community_intelligence",
        "personal_observation",
        "legacy_project",
        "analytical_model"
      ]
    },
    "source_role": {
      "enum": [
        "normative",
        "current_mirror",
        "structured_implementation",
        "runtime_projection",
        "validation_tooling",
        "analytics",
        "analysis",
        "event_overlay",
        "community_intelligence",
        "historical_baseline",
        "personal_collection",
        "tournament_raw",
        "meta_aggregator",
        "list_meta",
        "mathhammer",
        "expert_analysis",
        "architecture_reference"
      ]
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "checked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "status": {
      "enum": [
        "CURRENT_VERIFIED",
        "CURRENT_PENDING_RECHECK",
        "HISTORICAL_VERIFIED",
        "PROVISIONAL",
        "UNKNOWN"
      ]
    },
    "upstream_source_id": {
      "type": "string"
    },
    "use_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analytics_class": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independence_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_refresh_cadence": {
      "type": "string"
    },
    "observed_data_through": {
      "type": "string"
    },
    "source_health": {
      "enum": [
        "PASS",
        "PENDING",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "repository_coverage_state": {
      "enum": [
        "NOT_INGESTED",
        "PARTIAL",
        "COMPLETE",
        "REFERENCE_ONLY",
        "RUNTIME_ONLY",
        "HISTORICAL_ONLY",
        "PERSONAL_DATA",
        "NOT_APPLICABLE"
      ]
    },
    "observed_revision": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
