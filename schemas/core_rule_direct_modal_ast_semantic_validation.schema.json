{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/core_rule_direct_modal_ast_semantic_validation.schema.json",
  "title": "Core Rule Direct-Modal AST Semantic Validation V1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "snapshot_date",
    "authority",
    "validation_version",
    "parent_pilot",
    "validation",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "SOURCE_DRIFT"
      ]
    },
    "snapshot_date": {
      "type": "string"
    },
    "authority": {
      "const": "GAMES_WORKSHOP_OFFICIAL"
    },
    "validation_version": {
      "const": "CORE_RULE_DIRECT_MODAL_AST_SEMANTIC_VALIDATION_V1"
    },
    "parent_pilot": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "authority_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
