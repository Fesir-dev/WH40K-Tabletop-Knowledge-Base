{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/core_rule_paragraph_boundaries.schema.json",
  "title": "Core Rules paragraph/rule-body boundary index",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "snapshot_date",
    "authority",
    "boundary_version",
    "source",
    "source_verification",
    "parent_atomization",
    "rules",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "SOURCE_DRIFT",
        "FAIL"
      ]
    },
    "snapshot_date": {
      "type": "string"
    },
    "authority": {
      "const": "GAMES_WORKSHOP_OFFICIAL"
    },
    "boundary_version": {
      "const": "CORE_RULE_PARAGRAPH_BOUNDARY_EXTRACTION_V1"
    },
    "source": {
      "type": "object"
    },
    "source_verification": {
      "type": "object"
    },
    "parent_atomization": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_ref",
          "rule_key",
          "family_id",
          "classification",
          "occurrences"
        ],
        "properties": {
          "rule_ref": {
            "type": "string",
            "pattern": "^[0-9]{2}\\.[0-9]{2}$"
          },
          "rule_key": {
            "type": "string"
          },
          "family_id": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "classification": {
            "enum": [
              "SINGLE_OCCURRENCE_BOUNDARY",
              "REPEATED_OCCURRENCE_BOUNDARIES_IDENTICAL_HASH",
              "REPEATED_OCCURRENCE_BOUNDARIES_VARIANT_HASH",
              "EMPTY_BODY_BOUNDARY",
              "HEADING_LINE_RECOVERY_GAP"
            ]
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object"
    },
    "authority_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
