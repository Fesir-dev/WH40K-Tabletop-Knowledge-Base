{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"schemas/core_rule_reference_index.schema.json",
  "title":"Official Core Rules numbered reference index",
  "type":"object",
  "required":["schema_version","status","snapshot_date","authority","source","atoms","summary","authority_boundary"],
  "properties":{
    "schema_version":{"type":"string"},
    "status":{"enum":["PASS","SOURCE_DRIFT","FAIL"]},
    "snapshot_date":{"type":"string"},
    "authority":{"const":"GAMES_WORKSHOP_OFFICIAL"},
    "source":{"type":"object"},
    "atoms":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["rule_ref","rule_key","family_id","classification","family_page_start","family_page_end","in_family_heading_pages","primary_heading_page","heading_labels","page_semantic_sha256","cross_reference_pages"],
        "properties":{
          "rule_ref":{"type":"string","pattern":"^[0-9]{2}\\.[0-9]{2}$"},
          "rule_key":{"type":"string"},
          "family_id":{"type":"string","pattern":"^[0-9]{2}$"},
          "classification":{"enum":["UNIQUE_IN_FAMILY_HEADING","REPEATED_IN_FAMILY_HEADING","MULTIPLE_LABELS_SAME_PAGE","HEADING_RECOVERY_GAP"]},
          "family_page_start":{"type":"integer","minimum":1},
          "family_page_end":{"type":"integer","minimum":1},
          "in_family_heading_pages":{"type":"array","minItems":1,"items":{"type":"integer","minimum":1}},
          "primary_heading_page":{"type":"integer","minimum":1},
          "heading_labels":{"type":"array","items":{"type":"object"}},
          "page_semantic_sha256":{"type":"object"},
          "cross_reference_pages":{"type":"array","items":{"type":"integer","minimum":1}}
        },
        "additionalProperties":true
      }
    },
    "summary":{"type":"object"},
    "authority_boundary":{"type":"object"}
  },
  "additionalProperties":true
}
