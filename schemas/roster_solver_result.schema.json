{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/roster_solver_result.schema.json",
  "title": "Collection-aware Roster Solver Result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "rules",
    "points",
    "physical",
    "provenance",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "roster_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "INVALID_SCOPED_RULES",
        "SCOPED_RULES_PASS_PHYSICAL_INFEASIBLE",
        "SCOPED_RULES_PASS_PHYSICAL_UNKNOWN",
        "SCOPED_RULES_PASS_PHYSICAL_FEASIBLE"
      ]
    },
    "rules": {
      "type": "object"
    },
    "points": {
      "type": "object"
    },
    "physical": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "authority_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
