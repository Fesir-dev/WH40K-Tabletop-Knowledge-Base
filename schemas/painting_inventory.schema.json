{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/painting_inventory.schema.json",
  "title": "WH40K Painting Inventory Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "source_revision",
    "summary",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "source_artifact": {
      "type": "string"
    },
    "checked_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_containers_and_materials",
        "unique_products_by_identity",
        "brand_count"
      ],
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "brand",
          "name",
          "quantity"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
