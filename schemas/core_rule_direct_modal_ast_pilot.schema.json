{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"schemas/core_rule_direct_modal_ast_pilot.schema.json",
  "title":"Core Rules direct-modal AST pilot v1",
  "type":"object",
  "required":["schema_version","status","snapshot_date","authority","pilot_version","source","source_verification","parent_readiness","nodes","summary","authority_boundary"],
  "properties":{
    "schema_version":{"type":"string"},
    "status":{"enum":["PASS","FAIL","SOURCE_DRIFT"]},
    "snapshot_date":{"type":"string"},
    "authority":{"const":"GAMES_WORKSHOP_OFFICIAL"},
    "pilot_version":{"const":"CORE_RULE_DIRECT_MODAL_AST_PILOT_V1"},
    "source":{"type":"object"},
    "source_verification":{"type":"object"},
    "parent_readiness":{"type":"object"},
    "nodes":{
      "type":"array","minItems":1,"maxItems":1,
      "items":{
        "type":"object",
        "required":["node_key","node_type","rule_ref","paragraph_key","page","paragraph_semantic_sha256","subject_span","modal_operator","action_predicate_span","validation"],
        "properties":{
          "node_key":{"type":"string"},
          "node_type":{"const":"DIRECT_MODAL_CLAUSE"},
          "rule_ref":{"const":"13.07"},
          "paragraph_key":{"const":"core-rule-13-07--p50--l1--para-p50-o1"},
          "page":{"const":50},
          "paragraph_semantic_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "subject_span":{"$ref":"#/$defs/span"},
          "modal_operator":{
            "type":"object",
            "required":["operator","lexical_signal","relative_char_start","relative_char_end","semantic_sha256","token_count"],
            "properties":{
              "operator":{"const":"PERMISSION"},
              "lexical_signal":{"const":"PERMISSION_CAN"},
              "relative_char_start":{"type":"integer","minimum":0},
              "relative_char_end":{"type":"integer","minimum":1},
              "semantic_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
              "token_count":{"const":1}
            },
            "additionalProperties":true
          },
          "action_predicate_span":{"$ref":"#/$defs/span"},
          "validation":{"type":"object"}
        },
        "additionalProperties":true
      }
    },
    "summary":{"type":"object"},
    "authority_boundary":{"type":"object"}
  },
  "$defs":{
    "span":{
      "type":"object",
      "required":["relative_char_start","relative_char_end","absolute_char_start","absolute_char_end","char_count","token_count","semantic_sha256","semantic_type"],
      "properties":{
        "relative_char_start":{"type":"integer","minimum":0},
        "relative_char_end":{"type":"integer","minimum":1},
        "absolute_char_start":{"type":"integer","minimum":0},
        "absolute_char_end":{"type":"integer","minimum":1},
        "char_count":{"type":"integer","minimum":1},
        "token_count":{"type":"integer","minimum":1},
        "semantic_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "semantic_type":{"enum":["OPAQUE_SUBJECT_SPAN","OPAQUE_ACTION_PREDICATE_SPAN"]}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
