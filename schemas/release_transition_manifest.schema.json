{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/release_transition_manifest.schema.json",
  "title": "Warhammer 40,000 release transition manifest",
  "type": "object",
  "required": [
    "schema_version",
    "transition_id",
    "title",
    "factions",
    "baseline_current_state",
    "upcoming_state",
    "activation_evidence",
    "policy",
    "reingestion_scope"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "transition_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "baseline_current_state": {
      "const": "CURRENT_LEGAL"
    },
    "upcoming_state": {
      "type": "string"
    },
    "scheduled_release_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "official_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "activation_evidence": {
      "type": "object",
      "required": [
        "current_legal_confirmed",
        "confirmed_at",
        "evidence"
      ],
      "properties": {
        "current_legal_confirmed": {
          "type": "boolean"
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": [
        "preview_never_promotes",
        "date_alone_never_promotes",
        "require_official_current_legal_evidence",
        "require_upstream_change",
        "promotion_route"
      ],
      "properties": {
        "preview_never_promotes": {
          "const": true
        },
        "date_alone_never_promotes": {
          "const": true
        },
        "require_official_current_legal_evidence": {
          "const": true
        },
        "require_upstream_change": {
          "const": true
        },
        "promotion_route": {
          "const": "GUARDED_REINGESTION_CANDIDATE_REVIEWED_PROMOTION"
        }
      },
      "additionalProperties": true
    },
    "reingestion_scope": {
      "type": "object",
      "required": [
        "factions",
        "source_classes"
      ],
      "properties": {
        "factions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
