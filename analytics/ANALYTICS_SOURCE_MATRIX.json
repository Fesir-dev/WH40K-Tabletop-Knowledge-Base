{
  "schema_version": "1.0",
  "as_of": "2026-09-29",
  "purpose": "Source-role and lineage matrix for competitive 40K analytics. It prevents dependent aggregators from being mistaken for independent confirmation.",
  "independence_policy": {
    "rule": "Confidence is based on independent underlying evidence lineages, not the number of websites repeating the same tournament feed.",
    "examples": [
      "BCP + Infinite Archive performance metrics count primarily as one BCP-derived empirical lineage.",
      "Listhammer + Meta Merge do not become two independent winning-list samples when Meta Merge consumes Listhammer.",
      "Hutber statistics derived from BCP/Tabletop Herald are cross-checks/transformations of those feeds, not new raw tournaments.",
      "Expert sources are independent only when their conclusions are authored independently; an expert merely quoting an aggregator does not create a new empirical lineage."
    ]
  },
  "priority_tiers": {
    "P0": "Core ingestion: high-value, current and directly useful for reproducible roster/meta analysis.",
    "P1": "Strong supporting evidence or modelling; ingest after P0.",
    "P2": "Supplementary/interpretive evidence; useful for disagreement discovery and context."
  },
  "sources": [
